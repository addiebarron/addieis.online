---
import EmojiList from "@components/EmojiList.astro";
import Shadowbox from "../layouts/Shadowbox.astro";
---

<Shadowbox>
  <header class="prose-shadowbox">
    <h1>addie is online</h1>
    <p>(and hating every minute of it)</p>
  </header>
  <br />

  <h2>...but what about when she's not?</h2>
  <EmojiList
    list={[
      {
        emoji: "🌐",
        html: `she makes <a href="https://addieweb.com">websites</a> for clients looking for an alternative to corporate site builders`,
      },
      {
        emoji: "🌱",
        html: `she's a gardener caring for native plant installations with <a href="https://www.kylinarts.com" target="_blank">kylin arts</a> in philly`,
      },
      {
        emoji: "🌳",
        html: `she tends fruit trees and other urban food crops with the <a href="https://www.phillyorchards.org/" target="_blank">philly orchard project</a>.`,
      },
      {
        emoji: "🛜",
        html: `she helps build community controlled mesh networks at <a href="https://pcw.fi" target="_blank">philly community wireless</a>.`,
      },
      {
        emoji: "🌺",
        html: `she plays the drums, rides & fixes bikes, runs tabletop games, and reads in the park.`,
      },
    ]}
  />
</Shadowbox>
